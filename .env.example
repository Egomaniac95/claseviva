# Copiar a .env y completar solo valores locales. No guardar claves reales en git.

# Capturas WebP; 85 equilibra calidad visual y peso. Se conserva el ancho máximo previo.
CLASE_CAPTURA_CALIDAD=85
CLASE_CAPTURA_ANCHO=1920

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Costos estimados con tarifa versionada (caché y franja UTC); no son factura.
# https://api-docs.deepseek.com/quick_start/pricing/

# STT 100 % remoto. La interfaz pide consentimiento por sesión para la cadena
# secuencial AssemblyAI -> Deepgram -> Speechmatics -> Groq. Las claves faltantes
# se saltan sin alterar el orden; nunca pegues valores reales en este archivo.
# Autorización permanente: con 1 la casilla del panel llega ya marcada y no hay
# que repetir el clic. NO otorga el consentimiento por sí sola (el panel sigue
# enviando la casilla real y el preflight sigue rechazando si llega en false);
# la clase registra si la casilla venía premarcada en stt_remote_consent_prefilled.
CLASE_STT_REMOTE_CONSENT=0
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
GROQ_API_KEY=
CLASE_STT_BACKEND=remote
# Recorta pausas digitales >=2 s, conserva 300 ms a cada lado y restaura tiempos.
# No elimina ruido ni voz tenue. Con 0 se desactiva para nuevos trabajos.
CLASE_STT_TRIM_SILENCE=1
# Silero VAD CPU/ONNX incluido. Los recortes nuevos exigen ceros digitales.
# Con digital usa solo ese filtro, conservando señales no nulas de bajo volumen.
CLASE_STT_VAD=silero
# Modelos fijados por contrato en código: universal-3-5-pro, nova-3/multi,
# melia-1/multi y whisper-large-v3 (nunca turbo).
SPEECHMATICS_BASE_URL=https://us1.asr.api.speechmatics.com
# Dos intentos acotados por proveedor; no hay peticiones en paralelo.
CLASE_STT_PROVIDER_ATTEMPTS=2
# CLASE_STT_MAX_INLINE_RETRY_SEG=2
# CLASE_STT_POLL_INTERVAL_SEG=1
# CLASE_ASSEMBLYAI_STT_TIMEOUT_SEG=45
# CLASE_DEEPGRAM_STT_TIMEOUT_SEG=45
# CLASE_SPEECHMATICS_STT_TIMEOUT_SEG=45
# CLASE_GROQ_STT_TIMEOUT_SEG=45

# Idioma: auto detecta por chunk; tambien acepta es o en.
CLASE_IDIOMA=auto

# Material visual oficial para postproceso (opt-in). En Windows, separar varias rutas
# con punto y coma. También puede pasarse --material al comando de postproceso.
# CLASE_POST_MATERIALES=D:\ruta\slides-oficiales.pdf
